#!/bin/sh
# pre-push: cargo test --lib against the current working tree.
# Runs once per `git push`, regardless of how many commits.  fmt and
# clippy live in pre-commit; tests stay here because they're slower
# and don't need per-commit feedback.
#
# Override with: git push --no-verify

set -e

# Drain stdin so git doesn't block sending the push-info lines.
cat >/dev/null

if ! cargo test --lib --features mbelib,testing >&2; then
    printf '\npre-push: cargo test --lib failed.\n' >&2
    exit 1
fi
